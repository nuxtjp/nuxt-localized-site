{
  "repository": "nuxtjp/site-builder",
  "purpose": "Build Japanese/English product and organization sites from validated declarative content.",
  "responsibility_boundary": "Organizations own claims, links, release/download data attribution and deployment. A site preview or source merge is not production acceptance.",
  "packages": [
    {
      "manifest": "package.json",
      "package": "@nuxtjp/localized-site",
      "ecosystem": "npm",
      "description": "Contract-first Japanese and English public-site module for Nuxt",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./core": {
            "types": "./dist/runtime/core/index.d.ts",
            "import": "./dist/runtime/core/index.js"
          },
          "./validator": {
            "types": "./validator/content/index.d.ts",
            "import": "./validator/content/index.js"
          },
          "./schema": "./schemas/localized-site-v1.schema.json",
          "./organization": {
            "types": "./organization/index.d.mts",
            "import": "./organization/index.mjs"
          },
          "./showcase": {
            "types": "./validator/showcase/index.d.ts",
            "import": "./validator/showcase/index.js"
          },
          "./showcase/collectors": {
            "types": "./validator/showcase/collectors.d.ts",
            "import": "./validator/showcase/collectors.js"
          }
        },
        "bin": {
          "nuxtjp-localized-site": "./bin/nuxtjp-localized-site.mjs"
        },
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build:module": "nuxt-module-build build",
        "build:validator": "tsc -p tsconfig.validator.json",
        "build": "pnpm run build:validator && pnpm run build:module && nuxt build playground",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run && pnpm run test:organization && pnpm run test:dependency-security && pnpm run test:consumer-security",
        "validate:example": "node ./bin/nuxtjp-localized-site.mjs validate --content-root ./examples/content",
        "prepack": "pnpm test && pnpm typecheck && pnpm build && pnpm validate:example",
        "test:organization": "pnpm run build:validator && pnpm run build:module && node --test test/organization-check.mjs",
        "test:dependency-security": "node --test scripts/dependency-security.check.cjs",
        "test:consumer-security": "node --test scripts/consumer-security.check.mjs"
      }
    }
  ],
  "schema_definitions": [
    "schemas/localized-site-v1.schema.json",
    "schemas/public-maintenance-state-v1.schema.json"
  ],
  "test_sources": [
    "organization/workspace.mjs",
    "scripts/check-public-package.py",
    "scripts/consumer-security.check.mjs",
    "security/project.mjs",
    "src/runtime/core/path.ts",
    "src/runtime/core/seo.ts",
    "test/cli.test.ts",
    "test/contract.test.ts",
    "test/fixture.ts",
    "test/maintenance.test.ts",
    "test/messages.test.ts",
    "test/organization-check.mjs",
    "test/path.test.ts",
    "test/seo.test.ts",
    "test/showcase-collectors.test.ts",
    "test/showcase.test.ts"
  ],
  "example_sources": [
    "examples/content/site.config.json",
    "playground/app.vue",
    "playground/data/showcase.json",
    "playground/nuxt.config.ts",
    "playground/pages/oss/[id].vue",
    "playground/pages/oss/index.vue"
  ],
